+++ b/ggml/src/ggml-cuda/vendors/hip.h
@@ -192,6 +192,20 @@
 #define GCN
 #endif // defined(GCN5) || defined(GCN4)
 
+// Hygon DCU (K100/K500 series): the host side maps these device ids to cc = 0x92x/0x93x
+// and classifies them as CDNA2 (see ggml_cuda_parse_id), but there was no matching macro
+// on the device side, so the kernels fell back to the RDNA2 config tables. Host and
+// device then disagreed on the MMQ/MMVQ tile configuration (e.g. nthreads 512 vs 256),
+// which corrupted the shared memory tiling and produced NaN. Map them to CDNA2 here so
+// that both sides select the same config tables.
+#if defined(__gfx926__) || defined(__gfx928__) || defined(__gfx936__) || defined(__gfx938__)
+#define CDNA2
+// These targets do not have the mai-insts target feature enabled in the DTK toolchain, so MFMA
+// intrinsics cannot be compiled for them: keep AMD_MFMA_AVAILABLE off on the device side.
+// Must be kept in sync with GGML_CUDA_CC_IS_HYGON_DCU() in ../common.cuh.
+#define HYGON_DCU_NO_MFMA
+#endif // defined(__gfx926__) || defined(__gfx928__) || defined(__gfx936__) || defined(__gfx938__)
+
 #if defined(__gfx950__)
 #define CDNA4
 #endif // defined(__gfx950__)
