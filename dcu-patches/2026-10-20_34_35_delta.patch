+// ---------------------------------------------------------------------------------------------
+// Host side
+// ---------------------------------------------------------------------------------------------
+
+static bool mmac_q8_env_enabled() {
+    const char * env = getenv("GGML_CUDA_MMAC_Q8");
+    return env == nullptr || atoi(env) != 0;
+}
+
+static bool mmac_q51_env_enabled() {
+    const char * env = getenv("GGML_CUDA_MMAC_Q51");
+    return env == nullptr || atoi(env) != 0;
+}
+
+static bool mmac_q8q5_shape_ok(int64_t K) {
+    return K % 32 == 0 && K <= INT_MAX;
+}
+
+bool ggml_cuda_mmac_gemm_q8_0(cudaStream_t stream,
+                              const void * act, const void * weight, float * dst,
+                              int64_t tokens, int64_t features, int64_t K,
+                              int64_t w_row_stride) {
+    if (!mmac_q8_env_enabled() || !ggml_cuda_mmac_available()) {
+        return false;
+    }
+    if (tokens < QKQ_MIN_ROWS || features < QKQ_BN) {
+        return false;
+    }
+    if (!mmac_q8q5_shape_ok(K) || w_row_stride < K / 32 || w_row_stride > INT_MAX) {
+        return false;
+    }
+    if ((tokens + QKQ_BM - 1) / QKQ_BM > 65535 || features > INT_MAX) {
+        return false;
+    }
+
+    const dim3 grid((unsigned) ((features + QKQ_BN - 1) / QKQ_BN),
+                    (unsigned) ((tokens   + QKQ_BM - 1) / QKQ_BM));
+
+    static bool logged = false;
+    if (!logged) {
+        logged = true;
+        fprintf(stderr, "%s: MMAC Q8_0 GEMM in use, first shape tokens=%lld features=%lld K=%lld\n",
+                __func__, (long long) tokens, (long long) features, (long long) K);
+    }
+
+    mmac_gemm_q80_kernel<<<grid, QKQ_NT, 0, stream>>>(
+        (const char *) act, weight, dst,
+        (int) tokens, (int) features, (int) K, (int) w_row_stride);
+    return true;
+}
+
+bool ggml_cuda_mmac_gemm_q8_0_usable(const ggml_tensor * src0, const ggml_tensor * src1,
+                                     const ggml_tensor * dst) {
+    if (!src0 || !src1 || !dst) {
+        return false;
+    }
+    if (src0->type != GGML_TYPE_Q8_0 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (!mmac_q8_env_enabled() || !ggml_cuda_mmac_available()) {
+        return false;
+    }
+
+    GGML_TENSOR_BINARY_OP_LOCALS;
+
+    if (ne11 < QKQ_MIN_ROWS || ne01 < QKQ_BN || ne12 != 1 || ne13 != 1 ||
+            src0->ne[2] != 1 || src0->ne[3] != 1) {
+        return false;
+    }
+    if (!mmac_q8q5_shape_ok(ne00) ||
+            src0->nb[0] != ggml_type_size(src0->type) ||
+            src0->nb[1] % ggml_type_size(src0->type) != 0 ||
+            src1->nb[0] != sizeof(float) ||
+            src1->nb[1] == 0 ||
+            dst->nb[0] != sizeof(float) ||
+            dst->nb[1] != ne0 * sizeof(float)) {
+        return false;
+    }
+    return true;
+}
+
+bool ggml_cuda_mmac_gemm_q5_1_id_usable(const ggml_tensor * src0, const ggml_tensor * src1,
+                                        const ggml_tensor * ids, const ggml_tensor * dst) {
+    if (!src0 || !src1 || !ids || !dst) {
+        return false;
+    }
+    if (src0->type != GGML_TYPE_Q5_1 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+            ids->type != GGML_TYPE_I32) {
+        return false;
+    }
+    if (!mmac_q51_env_enabled() || !ggml_cuda_mmac_available()) {
+        return false;
+    }
+
+    GGML_TENSOR_BINARY_OP_LOCALS;
+
+    const int64_t n_expert_used = ids->ne[0];
+    const int64_t rows = ne12 * n_expert_used;
+
+    if (rows < QKQ_MIN_ROWS || ne01 < QKQ_GBN || ne13 != 1) {
+        return false;
+    }
+    if (!mmac_q8q5_shape_ok(ne00) ||
+            src0->nb[0] != ggml_type_size(src0->type) ||
+            src0->nb[1] % ggml_type_size(src0->type) != 0 ||
+            src0->nb[2] % ggml_type_size(src0->type) != 0 ||
+            src1->nb[0] != sizeof(float) ||
+            src1->nb[1] % (4 * sizeof(float)) != 0 ||
+            dst->nb[0] != sizeof(float) ||
+            dst->nb[1] != ne0 * sizeof(float) ||
+            ids->nb[0] != ggml_element_size(ids) ||
+            ne02 > 65535) {
+        return false;
+    }
+    return true;
+}
+
+bool ggml_cuda_mmac_gemm_q5_1_id(cudaStream_t stream,
+                                 const void * act, const void * weight, float * dst,
+                                 const int32_t * ids_src1, const int32_t * ids_dst, const int32_t * expert_bounds,
+                                 int64_t n_expert, int64_t rows, int64_t features, int64_t K,
+                                 int64_t act_stride, int64_t w_row_stride, int64_t w_mat_stride) {
+    if (!mmac_q51_env_enabled() || !ggml_cuda_mmac_available()) {
+        return false;
+    }
+    if (rows < QKQ_MIN_ROWS || features < QKQ_GBN || !mmac_q8q5_shape_ok(K)) {
+        return false;
+    }
+    if (act_stride % 4 != 0 || w_row_stride > INT_MAX || w_mat_stride > INT_MAX || n_expert > 65535 ||
+            features > INT_MAX || (rows + QKQ_GBM - 1) / QKQ_GBM > 65535) {
+        return false;
+    }
+
+    const dim3 grid((unsigned) ((features + QKQ_GBN - 1) / QKQ_GBN),
+                    (unsigned) ((rows     + QKQ_GBM - 1) / QKQ_GBM),
+                    (unsigned) n_expert);
+
+    static bool logged = false;
+    if (!logged) {
+        logged = true;
+        fprintf(stderr, "%s: MMAC Q5_1 grouped GEMM in use, first shape rows=%lld features=%lld K=%lld experts=%lld\n",
+                __func__, (long long) rows, (long long) features, (long long) K, (long long) n_expert);
+    }
+
+    mmac_gemm_q51_grouped_kernel<<<grid, QKQ_GNT, 0, stream>>>(
+        (const char *) act, weight, ids_src1, ids_dst, expert_bounds, dst,
+        (int) features, (int) K, act_stride, (int) w_row_stride, w_mat_stride);
+    return true;
+}
diff --git a/ggml/src/ggml-cuda/mmac-gemm-q8q5.cuh b/ggml/src/ggml-cuda/mmac-gemm-q8q5.cuh
new file mode 100644
index 0000000..5678241
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmac-gemm-q8q5.cuh
@@ -0,0 +1,34 @@
+#pragma once
+
+#include "common.cuh"
+
+// Hygon DCU MMAC matrix-core GEMM for Q8_0 (dense projections) and Q5_1 (routed expert
+// down-projections). Same idea as mmac-gemm-q4k.cuh: dequantize the 32-element sub-block into
+// the f16 LDS tile that the MMAC mainloop consumes, so no f16 copy of the weights exists.
+//
+// Why these two types: in Qwen3.8-Flash-Next the whole dense stack (attn_qkv, attn_gate,
+// ssm_out, hc_*, ple_*) is Q8_0 and every ffn_down_exps is Q5_1. Neither was covered by the
+// Q4_K path, so ~70% of prefill FLOPs still ran on the SIMT MMQ kernels.
+//
+// Contract is identical to the Q4_K entry points:
+//     dst[tokens][features] = act[tokens, K] * weight[features, K]^T
+// with K % 32 == 0 (Q8_0 / Q5_1 blocks are 32 elements, unlike Q4_K's 256).
+//
+// Toggle with GGML_CUDA_MMAC_Q8 / GGML_CUDA_MMAC_Q51 (default: enabled).
+
+bool ggml_cuda_mmac_gemm_q8_0(cudaStream_t stream,
+                              const void * act, const void * weight, float * dst,
+                              int64_t tokens, int64_t features, int64_t K,
+                              int64_t w_row_stride);
+
+bool ggml_cuda_mmac_gemm_q8_0_usable(const ggml_tensor * src0, const ggml_tensor * src1,
+                                     const ggml_tensor * dst);
+
+bool ggml_cuda_mmac_gemm_q5_1_id_usable(const ggml_tensor * src0, const ggml_tensor * src1,
+                                        const ggml_tensor * ids, const ggml_tensor * dst);
+
+bool ggml_cuda_mmac_gemm_q5_1_id(cudaStream_t stream,
+                                 const void * act, const void * weight, float * dst,
+                                 const int32_t * ids_src1, const int32_t * ids_dst, const int32_t * expert_bounds,
+                                 int64_t n_expert, int64_t rows, int64_t features, int64_t K,
+                                 int64_t act_stride, int64_t w_row_stride, int64_t w_mat_stride);
diff --git a/ggml/src/ggml-cuda/moe-host-split.cu b/ggml/src/ggml-cuda/moe-host-split.cu
new file mode 100644
index 0000000..2aa3101
--- /dev/null
+++ b/ggml/src/ggml-cuda/moe-host-split.cu
@@ -0,0 +1,178 @@
+// Hygon DCU: CPU half of the host-expert split. See moe-host-split.cuh for the rationale.
+
+#include "moe-host-split.cuh"
+#include "mmac-gemm.cuh"   // ggml-impl.h -> ggml-common.h (block_q4_K / block_q5_1)
+
+#include <immintrin.h>
+#include <omp.h>
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+// The host half runs on the CPU while the GPU kernel is in flight, so it is compiled for AVX2
+// explicitly instead of relying on the target flags of the rest of the backend.
+#pragma clang attribute push(__attribute__((target("avx2,fma"))), apply_to = function)
+
+namespace {
+
+// block_q4_K holds QK_K = 256 elements, block_q5_1 holds QK5_1 = 32. Both are declared in
+// ggml-common.h, which mmac-gemm.cuh pulls in.
+
+static inline float h2f(uint16_t h) {
+    return ggml_fp16_to_fp32(*(ggml_fp16_t *) &h);
+}
+
+// Same 6-bit packing as dequantize.cuh::get_scale_min_k4 (which is __device__ only).
+static inline void host_get_scale_min_k4(int j, const uint8_t * q, uint8_t * d, uint8_t * m) {
+    if (j < 4) {
+        *d = q[j]     & 63;
+        *m = q[j + 4] & 63;
+    } else {
+        *d = (q[j + 4] & 0xF) | ((q[j - 4] >> 6) << 4);
+        *m = (q[j + 4] >>  4) | ((q[j - 0] >> 6) << 4);
+    }
+}
+
+// sum(q[i] * a[i]) for 8 elements. `hi` selects the high nibbles of q.
+static inline __m256 dot_nib8(const uint8_t * q, const float * a, bool hi) {
+    const __m128i b  = _mm_loadl_epi64((const __m128i *) q);
+    __m256i       qi = _mm256_cvtepu8_epi32(b);
+    if (hi) {
+        qi = _mm256_srli_epi32(qi, 4);
+    } else {
+        qi = _mm256_and_si256(qi, _mm256_set1_epi32(0x0F));
+    }
+    return _mm256_mul_ps(_mm256_cvtepi32_ps(qi), _mm256_loadu_ps(a));
+}
+
+static inline float hsum256(__m256 v) {
+    __m128 t = _mm_add_ps(_mm256_castps256_ps128(v), _mm256_extractf128_ps(v, 1));
+    t = _mm_add_ps(t, _mm_movehl_ps(t, t));
+    t = _mm_add_ss(t, _mm_shuffle_ps(t, t, 1));
+    return _mm_cvtss_f32(t);
+}
+
+// a_blk[i] = sum of activation elements [32*i, 32*i+32). Shared by all output rows.
+static float dot_q4_K(const void * wp, const float * a, const float * a_blk, int64_t K) {
+    const block_q4_K * x = (const block_q4_K *) wp;
+    __m256 acc  = _mm256_setzero_ps();
+    float  bias = 0.0f;   // the -dmin*m_j*sum(a) terms; must not go through the 8-lane accumulator
+    for (int64_t i = 0; i < K/QK_K; ++i) {
+        // The scale/min header is a union whose member name depends on the declaration mode
+        // (anonymous for C, `data` for C++), so overlay it with a plain 2x half struct.
+        const uint16_t * hdr = (const uint16_t *) &x[i];
+        const float d  = h2f(hdr[0]);
+        const float mn = h2f(hdr[1]);
+        const uint8_t * q = x[i].qs;
+        for (int g = 0; g < 4; ++g) {
+            uint8_t s0, m0, s1, m1;
+            host_get_scale_min_k4(2*g + 0, x[i].scales, &s0, &m0);
+            host_get_scale_min_k4(2*g + 1, x[i].scales, &s1, &m1);
+            const int64_t b = 8*i + 2*g;
+            __m256 lo = _mm256_setzero_ps();
+            __m256 hi = _mm256_setzero_ps();
+            for (int l = 0; l < 32; l += 8) {
+                lo = _mm256_add_ps(lo, dot_nib8(q + l, a + 32*b       + l, false));
+                hi = _mm256_add_ps(hi, dot_nib8(q + l, a + 32*(b + 1) + l, true));
+            }
+            acc = _mm256_fmadd_ps(_mm256_set1_ps(d*s0), lo, acc);
+            acc = _mm256_fmadd_ps(_mm256_set1_ps(d*s1), hi, acc);
+            bias -= mn*(m0*a_blk[b] + m1*a_blk[b + 1]);
+            q += 32;
+        }
+    }
+    return hsum256(acc) + bias;
+}
+
+static float dot_q5_1(const void * wp, const float * a, const float * a_blk, int64_t K) {
+    const block_q5_1 * x = (const block_q5_1 *) wp;
+    const __m256i lane = _mm256_setr_epi32(0, 1, 2, 3, 4, 5, 6, 7);
+    __m256 acc  = _mm256_setzero_ps();
+    float  bias = 0.0f;
+    for (int64_t i = 0; i < K/QK5_1; ++i) {
+        const uint16_t * hdr = (const uint16_t *) &x[i];
+        const float d = h2f(hdr[0]);
+        const float m = h2f(hdr[1]);
+        uint32_t qh;
+        memcpy(&qh, x[i].qh, sizeof(qh));
+        const float * ap = a + 32*i;
+        __m256 lo = _mm256_setzero_ps();
+        __m256 hi = _mm256_setzero_ps();
+        for (int j = 0; j < 16; j += 8) {
+            const __m128i b  = _mm_loadl_epi64((const __m128i *) (x[i].qs + j));
+            const __m256i qi = _mm256_cvtepu8_epi32(b);
+            // Element j keeps qs[j]'s low nibble and qh bit j; element j+16 keeps the high
+            // nibble of the same byte and qh bit j+16.
+            // The 5th bit of element e is bit e of qh. srli+mask would leave it at 1<<lane,
+            // so shift per lane and keep only bit 0 before moving it into position 4.
+            const __m256i qhb = _mm256_set1_epi32((int) qh);
+            const __m256i b0 = _mm256_slli_epi32(_mm256_and_si256(
+                    _mm256_srlv_epi32(qhb, _mm256_add_epi32(lane, _mm256_set1_epi32(j))),
+                    _mm256_set1_epi32(1)), 4);
+            const __m256i b1 = _mm256_slli_epi32(_mm256_and_si256(
+                    _mm256_srlv_epi32(qhb, _mm256_add_epi32(lane, _mm256_set1_epi32(j + 16))),
+                    _mm256_set1_epi32(1)), 4);
+            const __m256i q0 = _mm256_or_si256(_mm256_and_si256(qi, _mm256_set1_epi32(0x0F)), b0);
+            const __m256i q1 = _mm256_or_si256(_mm256_srli_epi32(qi, 4), b1);
+            lo = _mm256_add_ps(lo, _mm256_mul_ps(_mm256_cvtepi32_ps(q0), _mm256_loadu_ps(ap + j)));
+            hi = _mm256_add_ps(hi, _mm256_mul_ps(_mm256_cvtepi32_ps(q1), _mm256_loadu_ps(ap + j + 16)));
+        }
+        acc  = _mm256_fmadd_ps(_mm256_set1_ps(d), _mm256_add_ps(lo, hi), acc);
+        bias += m*a_blk[i];
+    }
+    return hsum256(acc) + bias;
+}
+
+// a_blk[i] = sum of activation elements [32*i, 32*i+32), one row at a time.
+static void act_block_sums(const float * act, int64_t act_stride, int n_rows, int64_t n32, float * out) {
+    for (int e = 0; e < n_rows; ++e) {
+        const float * a = act + e*act_stride;
+        for (int64_t i = 0; i < n32; ++i) {
+            __m256 s = _mm256_setzero_ps();
+            for (int j = 0; j < 32; j += 8) {
+                s = _mm256_add_ps(s, _mm256_loadu_ps(a + 32*i + j));
+            }
+            out[(size_t) e*n32 + i] = hsum256(s);
+        }
+    }
+}
+
+} // namespace
+
+#pragma clang attribute pop
+
+bool ggml_cuda_moe_host_split_supported(enum ggml_type type, int64_t K) {
+    switch (type) {
+        case GGML_TYPE_Q4_K: return K % QK_K  == 0;
+        case GGML_TYPE_Q5_1: return K % QK5_1 == 0;
+        default:             return false;
+    }
+}
+
+void ggml_cuda_moe_host_split_rows(
+        enum ggml_type type,
+        const char * w, int64_t w_row_stride, int64_t w_mat_stride,
+        const float * act, int64_t act_stride, int64_t K,
+        const int32_t * experts, int n_rows, int64_t M,
+        float * out, int n_threads) {
+    const int64_t n32 = K/32;
+
+    // Block sums of the activations: one pass per row instead of once per output row.
+    static std::vector<float> a_blk;
+    a_blk.resize((size_t) n_rows * n32);
+    act_block_sums(act, act_stride, n_rows, n32, a_blk.data());
+
+    const int64_t total = (int64_t) n_rows * M;
+    #pragma omp parallel for num_threads(n_threads) schedule(static)
+    for (int64_t i = 0; i < total; ++i) {
+        const int     e = (int) (i / M);
+        const int64_t m = i % M;
+        const char *  p = w + (int64_t) experts[e]*w_mat_stride + m*w_row_stride;
+        const float * a = act + (int64_t) e*act_stride;
+        const float * ab = a_blk.data() + (size_t) e*n32;
+        out[i] = type == GGML_TYPE_Q4_K ? dot_q4_K(p, a, ab, K) : dot_q5_1(p, a, ab, K);
+    }
+}
diff --git a/ggml/src/ggml-cuda/moe-host-split.cuh b/ggml/src/ggml-cuda/moe-host-split.cuh
new file mode 100644
index 0000000..dfc420f
--- /dev/null
+++ b/ggml/src/ggml-cuda/moe-host-split.cuh
@@ -0,0 +1,30 @@
+// Hygon DCU: CPU half of the host-expert split (see ggml_cuda_moe_host_split in ggml-cuda.cu).
+//
+// The host-resident expert layers of this model are read over PCIe by the GPU at ~15.4 GB/s
+// (PCIe 3.0 x16 ceiling) while the 8 cores the server is pinned to stream the same weights out
+// of DRAM at ~16 GB/s. The two resources are independent, so giving each path half of the
+// expert slots and running them concurrently halves the per-layer cost (measured: 1.32 ms and
+// 1.27 ms per layer for the two paths separately).
+//
+// This file implements the CPU side: out[e][m] = dot(W[experts[e]] + m*w_row_stride, act[e]).
+// The dot is fused with on-the-fly dequantization, using q8_0 activations so that 32 elements
+// are consumed per vpmaddubsw (the same trick ggml-cpu uses).
+
+#pragma once
+
+#include "ggml.h"
+
+#include <cstdint>
+
+// True if the CPU kernels below understand this quantized type at the given K.
+bool ggml_cuda_moe_host_split_supported(enum ggml_type type, int64_t K);
+
+// act:      n_rows activation rows, each K floats, row stride act_stride floats
+// experts:  n_rows expert indices into w (w_mat_stride bytes apart)
+// out:      n_rows * M floats, laid out as out[e*M + m]
+void ggml_cuda_moe_host_split_rows(
+        enum ggml_type type,
+        const char * w, int64_t w_row_stride, int64_t w_mat_stride,
+        const float * act, int64_t act_stride, int64_t K,
+        const int32_t * experts, int n_rows, int64_t M,
+        float * out, int n_threads);
